# Copy to backend/.env. Never commit real credentials.
MEETINGFLOW_APP_NAME=MeetingFlow
MEETINGFLOW_HOST=127.0.0.1
MEETINGFLOW_PORT=8000
MEETINGFLOW_DISPLAY_TIMEZONE=Asia/Shanghai
# Write requests must include a trusted Origin or Referer.
MEETINGFLOW_TRUSTED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]
MEETINGFLOW_SESSION_HOURS=8
# Set true when deployed behind HTTPS.
MEETINGFLOW_COOKIE_SECURE=false
# One backend process only. Without a configured model, jobs fail explicitly.
MEETINGFLOW_ANALYSIS_WORKER_ENABLED=true
# Demo mode accepts only the sample offered by the UI; it is not a real AI model.
MEETINGFLOW_ANALYSIS_MODE=demo
# Real analysis and free-form assistant: set analysis mode to deepseek.
# Fixed query buttons and local models never call this paid API.
MEETINGFLOW_DEEPSEEK_MODEL=deepseek-flash
# MEETINGFLOW_DEEPSEEK_API_KEY=replace_with_your_official_key
# Enable local inference after running python -m scripts.download_models.
MEETINGFLOW_ASR_MODE=unconfigured
MEETINGFLOW_EMBEDDING_MODE=keyword
MEETINGFLOW_ASR_MAX_SECONDS=600
# Private audio files; relative paths resolve from backend/, never from the launch directory.
MEETINGFLOW_AUDIO_STORAGE_DIR=storage/audio
MEETINGFLOW_AUDIO_MAX_MB=50
# Configure the database in T02. URL-encode special characters in credentials.
# MEETINGFLOW_DATABASE_URL=mysql+pymysql://meetingflow:REPLACE_ME@127.0.0.1:3306/meetingflow?charset=utf8mb4
